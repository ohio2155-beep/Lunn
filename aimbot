-- ================= LOCK SYSTEM =================
local headLock=false
local bodyLock=false
local lockAll=false
local targets={}
local index=1

local function visible(part)
    local params=RaycastParams.new()
    params.FilterType=Enum.RaycastFilterType.Blacklist
    params.FilterDescendantsInstances={plr.Character}
    local ray=workspace:Raycast(cam.CFrame.Position,part.Position-cam.CFrame.Position,params)
    return ray and ray.Instance:IsDescendantOf(part.Parent)
end

headLockBtn.MouseButton1Click:Connect(function()
    headLock=not headLock
    bodyLock=false
    lockAll=false
    headLockBtn.Text=headLock and "🎯 ล็อคหัว : เปิด" or "🎯 ล็อคหัว : ปิด"
    bodyLockBtn.Text="🎯 ล็อคตัว : ปิด"
    lockAllBtn.Text="🌐 ล็อคทั้งเซิฟ : ปิด"
end)

bodyLockBtn.MouseButton1Click:Connect(function()
    bodyLock=not bodyLock
    headLock=false
    lockAll=false
    bodyLockBtn.Text=bodyLock and "🎯 ล็อคตัว : เปิด" or "🎯 ล็อคตัว : ปิด"
    headLockBtn.Text="🎯 ล็อคหัว : ปิด"
    lockAllBtn.Text="🌐 ล็อคทั้งเซิฟ : ปิด"
end)

lockAllBtn.MouseButton1Click:Connect(function()
    lockAll=not lockAll
    headLock=false
    bodyLock=false
    lockAllBtn.Text=lockAll and "🌐 ล็อคทั้งเซิฟ : เปิด" or "🌐 ล็อคทั้งเซิฟ : ปิด"
    headLockBtn.Text="🎯 ล็อคหัว : ปิด"
    bodyLockBtn.Text="🎯 ล็อคตัว : ปิด"
end)

R.RenderStepped:Connect(function()
    if lockAll then
        targets={}
        for _,p in pairs(P:GetPlayers()) do
            if p~=plr and p.Character then
                local h=p.Character:FindFirstChild("Head")
                local hum=p.Character:FindFirstChildOfClass("Humanoid")
                if h and hum and hum.Health>0 and visible(h) then
                    table.insert(targets,h)
                end
            end
        end
        if #targets>0 then
            if index>#targets then index=1 end
            cam.CFrame=CFrame.new(cam.CFrame.Position,targets[index].Position)
            index+=1
        end
    elseif headLock or bodyLock then
        local closest,dist=nil,math.huge
        for _,p in pairs(P:GetPlayers()) do
            if p~=plr and p.Character then
                local hum=p.Character:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health>0 then
                    local part=headLock and p.Character:FindFirstChild("Head") or p.Character:FindFirstChild("HumanoidRootPart")
                    if part and visible(part) then
                        local d=(cam.CFrame.Position-part.Position).Magnitude
                        if d<dist then dist=d closest=part end
                    end
                end
            end
        end
        if closest then
            cam.CFrame=CFrame.new(cam.CFrame.Position,closest.Position)
        end
    end
end)
