-- ระบบการทำงาน (Logic)
---------------------------------------------------------

local isLooping = false

local function runScript(code)
    if code and code ~= "" then
        local func, err = loadstring(code)
        if func then
            task.spawn(func)
        else
            warn("[SYSTEM ERROR]:", err)
        end
    end
end

-- ยืนยัน Key
KeySubmitBtn.MouseButton1Click:Connect(function()
    if KeyTextBox.Text == "กล้าคนหล่อ" then
        KeyFrame:Destroy()
        MainFrame.Visible = true
        ToggleBtn.Visible = true
    else
        KeyTextBox.Text = ""
        KeyTextBox.PlaceholderText = "ACCESS DENIED: INVALID KEY"
    end
end)

-- กดปุ่ม รันปกติ
ExecOnceBtn.MouseButton1Click:Connect(function()
    runScript(TextBox.Text)
end)

-- กดปุ่ม รันพร้อมกัน 1,000 ครั้งทันที
Exec1000xBtn.MouseButton1Click:Connect(function()
    if TextBox.Text ~= "" then
        local func = loadstring(TextBox.Text)
        if func then
            for i = 1, 1000 do
                task.spawn(func)
            end
        end
    end
end)

-- ⚡ กดปุ่ม Loop (รัน 10 ครั้ง ทุกๆ 0.01 วินาที)
LoopBtn.MouseButton1Click:Connect(function()
    if isLooping then return end
    isLooping = true
    
    task.spawn(function()
        while isLooping do
            if TextBox.Text ~= "" then
                local func = loadstring(TextBox.Text)
                if func then
                    -- ยิงการทำงานพร้อมกัน 10 ครั้ง
                    for i = 1, 10 do
                        task.spawn(func)
                    end
                end
            end
            task.wait(0.01) -- ระยะเวลาหน่วง 0.01 วินาที
        end
    end)
end)

-- กดปุ่ม หยุด Loop
StopBtn.MouseButton1Click:Connect(function()
    isLooping = false
end)

